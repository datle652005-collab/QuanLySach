<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đặt hàng nhanh"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="#111827"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/tvBookName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tên sách"
        android:textStyle="bold"
        android:textSize="17sp"
        android:textColor="#111827"/>

    <TextView
        android:id="@+id/tvBookPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="120.000 VNĐ"
        android:textColor="#EF4444"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/tvStock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Còn 10 sản phẩm"
        android:textColor="#10B981"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:id="@+id/layoutSelectAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/bg_edittext"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Địa chỉ nhận hàng"
                android:textColor="#6B7280"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thay đổi >"
                android:textColor="#2563EB"
                android:textStyle="bold"
                android:textSize="13sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvReceiverNamePhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đang tải thông tin..."
            android:textStyle="bold"
            android:textColor="#111827"
            android:textSize="15sp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvAddressDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vui lòng chọn địa chỉ"
            android:textColor="#4B5563"
            android:textSize="14sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Số lượng:"
            android:textSize="16sp"
            android:textColor="#111827"/>

        <Button
            android:id="@+id/btnMinus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="-"/>

        <EditText
            android:id="@+id/edtQuantity"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:inputType="number"
            android:background="@android:color/transparent"
            android:text="1"/>

        <Button
            android:id="@+id/btnPlus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="+"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tổng tiền: 0 VNĐ"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#DC2626"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Xác nhận đặt hàng"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2563EB"/>
</LinearLayout>