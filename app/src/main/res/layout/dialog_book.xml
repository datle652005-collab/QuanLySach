<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F8FAFC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tên sách"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/edName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F1F5F9"
                        android:hint="Nhập tên sách"
                        android:padding="12dp"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tác giả"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/edAuthor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F1F5F9"
                        android:hint="Tên tác giả"
                        android:padding="12dp"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giá bán (VNĐ)"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/edPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F1F5F9"
                        android:hint="Ví dụ: 150000"
                        android:inputType="number"
                        android:padding="12dp"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ảnh bìa sách"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgBookPreview"
                            android:layout_width="80dp"
                            android:layout_height="110dp"
                            android:background="#F1F5F9"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/CornerRadius8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelectImage"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Đổi ảnh"
                            android:textColor="#1D4ED8"
                            app:strokeColor="#1D4ED8" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thể loại"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp"/>
                    <Spinner
                        android:id="@+id/spTheLoai"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:backgroundTint="#64748B" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Số lượng tồn kho"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/edSoLuong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F1F5F9"
                        android:hint="Nhập số lượng"
                        android:inputType="number"
                        android:padding="12dp"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hashtags"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/edTags"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F1F5F9"
                        android:hint="Ví dụ: hot, trend, 2024"
                        android:padding="12dp"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mô tả nội dung"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/edDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F1F5F9"
                        android:gravity="top"
                        android:hint="Nhập mô tả chi tiết..."
                        android:minLines="3"
                        android:padding="12dp"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PHẦN CHỌN VIDEO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:text="Video giới thiệu"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <FrameLayout
                        android:id="@+id/layoutVideoPreview"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginBottom="12dp"
                        android:background="#F1F5F9"
                        android:visibility="gone">

                        <VideoView
                            android:id="@+id/videoPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center" />

                        <ImageView
                            android:id="@+id/btnPlayPreview"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_media_play"
                            app:tint="#7C3AED" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvSelectedVideo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Chưa có video giới thiệu"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectVideo"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chọn video từ máy"
                        android:textColor="#7C3AED"
                        app:strokeColor="#7C3AED" />

                    <ProgressBar
                        android:id="@+id/progressVideoUpload"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvVideoProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0%"
                        android:textColor="#7C3AED"
                        android:textSize="13sp"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>