<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF"
    android:gravity="center_horizontal">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#CBD5E1"
        android:layout_marginBottom="15dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thanh toán qua Ví MoMo"
        android:textColor="#A50064"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvMoMoOrderId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Nội dung chuyển khoản: Đang tải..."
        android:textColor="#334155"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <ImageView
        android:id="@+id/ivMoMoQR"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginVertical="15dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_chat_gallery" /> <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:text="⚠️ Lưu ý quan trọng: Vui lòng giữ nguyên nội dung chuyển khoản tự động để Admin kiểm tra và duyệt đơn nhanh nhất!"
    android:textColor="#DC2626"
    android:textSize="13sp"
    android:textStyle="italic"/>

    <Button
        android:id="@+id/btnOpenMoMoApp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#A50064"
        android:textColor="#FFFFFF"
        android:text="Mở ứng dụng MoMo để quét"
        android:textStyle="bold" />
</LinearLayout>