<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="110dp">

        <LinearLayout
            android:id="@+id/layoutLeft"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:background="#EE4D2D"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/ivLeftIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_money"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvLeftLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="GIẢM GIÁ"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:id="@+id/viewDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_dash_line"
            android:layerType="software"
            app:layout_constraintStart_toEndOf="@id/layoutLeft" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/viewDivider">

            <TextView
                android:id="@+id/tvVoucherTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="32dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Giảm 12% Giảm tối đa 999k"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvVoucherInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Đơn tối thiểu 250k"
                android:textColor="#757575"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvVoucherTitle" />

            <TextView
                android:id="@+id/tvApplyTo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFF5F1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="HSD: 31/12/2026"
                android:textColor="#EE4D2D"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <RadioButton
                android:id="@+id/rbSelectVoucher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#EE4D2D"
                android:clickable="false"
                android:focusable="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="-7dp"
            android:background="@drawable/circle_cutout"
            app:layout_constraintEnd_toEndOf="@id/viewDivider"
            app:layout_constraintStart_toStartOf="@id/viewDivider"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginBottom="-7dp"
            android:background="@drawable/circle_cutout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/viewDivider"
            app:layout_constraintStart_toStartOf="@id/viewDivider" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>