<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <queries>
        <package android:name="vn.momo.platform" />
    </queries>

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:icon="@drawable/img_1"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuanLySach"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <activity
            android:name=".ui.activity.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activity.PolicyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.HelpCenterActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.AllReviewsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.DanhGiaSanPhamActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.UserOrderDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.MyOrdersActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.RevenueActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.AdminChatListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.ConsultChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.activity.NotificationsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.OrderDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.CartActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.CheckoutActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />
        <activity
            android:name=".ui.activity.ActivityOrderSuccess"
            android:exported="false" />
        <activity
            android:name=".ui.activity.AddressListActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />
        <activity
            android:name=".ui.activity.AddAddressActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />
        <activity
            android:name=".ui.activity.AdminActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.ManageBooksActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".ui.activity.AddBookActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.ManageOrdersActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.ManageUsersActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.ManageVoucherActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.AddVoucherActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.ReportsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.ForgotPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.VerifyOTPActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.ResetPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.ChangePasswordActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.EditProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.AccountSecurityActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.BookDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.PromotionActivity"
            android:exported="false"
            android:parentActivityName=".ui.activity.MainActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".ui.activity.MainActivity" />
        </activity>
        <activity
            android:name=".ui.activity.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.activity.LiveStreamActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.activity.StreamerProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.UploadVideoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.NotificationDetailActivity"
            android:exported="false" />

        <service
            android:name=".data.api.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>